# --- Backend / Railway ---
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Opcjonalnie zamiast / obok secretu (JWKS ES256/RS256):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated
ALLOWED_ORIGINS=http://localhost:3000

# --- Stripe Checkout (OMS) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...   # opcjonalnie; MVP przekierowuje na session.url
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SITE_URL=http://localhost:3000
ADMIN_EMAILS=ops@example.com,second@example.com
# MIN_ORDER_PLN=30
# SHIPPING_AMOUNT_PLN=0

# --- Frontend / Next.js (Auth only) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
